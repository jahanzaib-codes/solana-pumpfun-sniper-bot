# ==========================================
# Solana Pump.fun Sniper Bot Configuration
# ==========================================

# 1. Network & RPC Connections (Use private RPC like Helius or QuickNode for production)
RPC_ENDPOINT="https://api.mainnet-beta.solana.com"
RPC_WEBSOCKET_ENDPOINT="wss://api.mainnet-beta.solana.com"

# 2. Trader Wallet Configuration
# Base58 encoded private key (Never commit this to git!)
WALLET_PRIVATE_KEY="YOUR_BASE58_SOLANA_PRIVATE_KEY_HERE"

# 3. Execution & Sizing Parameters
BUY_AMOUNT_SOL=0.5
SLIPPAGE_BPS=500                 # 500 bps = 5% slippage tolerance
SIMULATION_MODE=true             # Set to false for live on-chain trades

# 4. Jito MEV Bundle Configuration
JITO_BLOCK_ENGINE_URL="https://mainnet.block-engine.jito.wtf"
JITO_TIP_AMOUNT_SOL=0.005        # Tip paid to Jito validator for 0-block inclusion
USE_JITO_BUNDLES=true

# 5. Risk & Honeypot Filtering
MAX_TOP10_HOLDER_PERCENT=35.0    # Discard if top 10 holders own more than 35%
REQUIRE_REVOKED_MINT=true        # Discard if mint authority is not revoked
REQUIRE_REVOKED_FREEZE=true      # Discard if freeze authority is not revoked
MIN_INITIAL_LIQUIDITY_SOL=10.0   # Minimum pool liquidity required

# 6. Automated Profit Taking & Stop Loss
TAKE_PROFIT_MULTIPLIER=2.0       # Sell 50% position at 2x (100% gain)
STOP_LOSS_PERCENT=25.0           # Stop out if price drops 25% below entry
TRAILING_STOP_LOSS=true
TRAILING_STOP_PERCENT=15.0

